# Set these as Supabase function secrets (never commit real values):
#   supabase secrets set --env-file ./.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to functions.

# Your website address(es), comma separated. Only these can call the functions from a browser.
ALLOWED_ORIGINS=https://yourapp.netlify.app,https://www.yourdomain.in
SITE_URL=https://yourapp.netlify.app

# AI certificate scan (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (https://resend.com). MAIL_FROM must be on a domain you verified there.
RESEND_API_KEY=
MAIL_FROM=Standout <no-reply@yourdomain.in>
ADMIN_EMAIL=you@yourdomain.in

# SMS codes (Twilio shown; in India you may prefer MSG91 and need DLT registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
